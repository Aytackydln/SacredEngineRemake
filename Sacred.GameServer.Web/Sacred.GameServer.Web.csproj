<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Web management UI of the headless GameServer: a small Kestrel host (AOT/trim friendly, no reflection, source generated JSON)
    plus a server rendered page (minimal API endpoints, SSE chat). It knows the game server only through IServerAdmin, so it has no reference to Sacred.GameServer
    (which references this project and implements the interface).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sacred.GameServer.Web</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
