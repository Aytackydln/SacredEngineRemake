<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sacred.Core\Sacred.Core.csproj" />
    <ProjectReference Include="..\Sacred.Assets\Sacred.Assets.csproj" />
    <ProjectReference Include="..\Sacred.Granny\Sacred.Granny.csproj" />
    <ProjectReference Include="..\Sacred.Shaders\Sacred.Shaders.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Embeds\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Embeds\*.tga" />
  </ItemGroup>
</Project>
