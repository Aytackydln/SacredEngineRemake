  "observations": [
    "All positive item definitions use Items.pak graphic representation 0x0009.",
    "Positive definitions do not share a graphic flag: observed values are 0x0000, 0x0001, and 0x0002.",
    "Candelabra 1, Candle 5, Candle 6, and SimpleLightSmall have both positive and negative placements.",
    "MiniObjTex20 is a negative sample despite graphic flag 0x0002; it is an animated local halo, not surface lighting.",
    "The 5085_606 lights-outlined screenshot contributes 23 positives: ten SimpleLight markers, ten Candle 5/6 sconces, two Candelabra 1 fixtures, and one CandleWall01 fixture.",
    "No additional byte meaning is proven by this sample set. The raw records are retained for further correlation."
  ],
  "single_source_of_truth": {
    "status": "no_complete_game_file_discriminator_found",
    "conclusion": "No one field in Static.PAK, Items.pak, mixed.pak, Texture.pak, Floor.PAK, or sectors.wldx classifies every annotated surface-light source and rejects every negative sample.",
    "proven_game_file_rule": {
      "applies_to": "explicit invisible SimpleLight markers only",
      "source": "pak/Items.pak model descriptor",
      "predicate": "(graphic_type_raw \u0026 0x000F) == 0x0009 \u0026\u0026 (graphic_flags_raw \u0026 0x0002) != 0",
      "radius_field": "model_extent at descriptor offset 0x32"
    },
    "unresolved_mixed_sprite_rule": {
      "applies_to": "visible mixed-sprite fixtures such as Candle 5/6, DUN_light_1, 3S_FIRE, LICHTER_*, and FEUERSTELLE_MIT_STEIN_01",
      "evidence": [
        "Their Items.pak graphic flags vary across 0x0000 and 0x0001 and therefore do not use the explicit marker bit.",
        "Positive and negative instances of the same item type have identical non-coordinate Static.PAK properties.",
        "mixed.pak group and piece metadata has no shared positive-only value.",
        "Texture.pak and Texture.TMP headers have no shared positive-only metadata value.",
        "Floor.PAK overlays are absent within five tiles of most positive fixtures.",
        "Outdoor positive locations can have ordinary fully bright sectors.wldx baked-light values.",
        "Sacred.exe contains no direct 16-bit or 32-bit immediate comparison against any sampled positive or hard-negative item ID."
      ],
      "implication": "Do not turn the current model-name, item-ID, colour, or atlas heuristics into a generic Sacred.* rule. More native-renderer tracing is required before a complete game-data mapping can be named."
    },
    "supervised_label_source": "The positive_static_ids in the generated scenes.json are the canonical labels for this research dataset; archive JSONL files derive their labels from that one list."
  },
